# .yamllint configuration for 3-adic-ml YAML configs

# Relax line-length for configs (often have long URLs, paths)
line-length:
  max: 120
  level: warning

# Allow comments anywhere
comments:
  level: warning

# Document start is optional for configs
document-start: disable

# Use 2 spaces for indentation (YAML standard)
indentation:
  spaces: 2

# Disable redundant trailing whitespace check
trailing-spaces: warn