# Project specific (Ignore data/ at root level only (not src/data/)
# Note: /data/* (not /data/) so git still descends into subdirectories --
# an ignored *directory* can't be selectively un-ignored below, only its contents can.
/data/*
local/

# Cytochrome C phylogeny pipeline (Phase 1, docs/plans/PHYLOGENY-VALIDATION-PIPELINE.md):
# commit only the fetch manifest for provenance auditing; raw sequences/taxonomy/
# derived tensors are regenerable from it via scripts/data/fetch_cytochrome_c.py.
!/data/cytochrome_c/
/data/cytochrome_c/*
!/data/cytochrome_c/manifest.csv
src/c/*.o
src/c/*.so
src/c/*.pyd

# Generated metrics (can be regenerated, but keep curated analysis results)
**/metrics/
!/research/**/data/metrics/README.md

# Temporary reports at root level
/reports/*
!/reports/README.md

# Large data files and archives (keep locally)
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.7z
**/large_data/
**/datasets/
**/data/large/

# Checkpoints with the .pt files, sandbox and experimental training
models/checkpoints/
checkpoints/
sandbox-training/
sandbox/

# Large model checkpoints (stored on Hugging Face Hub)
# Use: python -m src.utils.checkpoint_hub download --checkpoint <name>
**/*.pt
*.7z
/visualizations/

